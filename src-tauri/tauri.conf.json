{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Troy",
  "version": "2.1.0",
  "identifier": "com.pixeldooooog.troy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Troy",
        "width": 1040,
        "height": 700,
        "minWidth": 700,
        "minHeight": 500,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3QzExQzkxMjZEMzE0MDAKUldRQUZOTW1rUnpCVjQ1SDdEWGI2bDJoUEdGdXhaTURhaWVVWWxnU09RUzdDZHl1WmgxVFBQSW4K",
      "endpoints": ["https://github.com/Pixeldooooog/Troy/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
